{
  "uid": "mabell-gateway",
  "title": "Ma Bell Gateway",
  "tags": ["mabell"],
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Calls",
      "description": "Calls started in the selected period.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
          "queryType": "stats",
          "expr": "event:=\"call.started\" | stats count() calls"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Handset lifted",
      "description": "Times the handset was lifted in the selected period.",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
          "queryType": "stats",
          "expr": "event:=\"phone.off_hook\" | stats count() lifts"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Restarts",
      "description": "Times the gateway started in the selected period.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
          "queryType": "stats",
          "expr": "event:=\"system.boot\" | stats count() restarts"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Broker reconnections",
      "description": "Times the gateway connected to the broker. More than restarts means the connection dropped in between.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
          "queryType": "stats",
          "expr": "event:=\"mqtt.connected\" | stats count() connections"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Warnings and errors",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
          "queryType": "stats",
          "expr": "level:in(warn, error) | stats count() problems"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events by kind",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
          "queryType": "statsRange",
          "expr": "event:* | stats by (event) count() events",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WiFi signal when connecting to the broker",
      "description": "Reported each time the gateway connects, not continuously.",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
      "fieldConfig": {
        "defaults": { "unit": "dBm", "custom": { "drawStyle": "points", "pointSize": 6 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
          "queryType": "statsRange",
          "expr": "rssi:* | stats by (device) avg(rssi) rssi",
          "legendFormat": "{{device}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Gateway events",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 14 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "deevnet-logs-devices" },
          "queryType": "instant",
          "expr": "*"
        }
      ]
    }
  ]
}
